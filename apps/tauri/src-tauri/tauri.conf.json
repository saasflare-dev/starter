{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Saasflare Desktop",
  "version": "0.1.0",
  "identifier": "dev.saasflare.desktop",
  "plugins": {},
  "build": {
    "beforeDevCommand": "pnpm run vite:dev",
    "devUrl": "http://localhost:4200",
    "beforeBuildCommand": "pnpm run vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Saasflare Desktop",
        "width": 1020,
        "height": 680,
        "minWidth": 560,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
